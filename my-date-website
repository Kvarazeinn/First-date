<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>دعوة خاصة 🌸</title>
  <style>
    :root {
      --bg-color: #fdf2f4;
      --card-bg: #ffffff;
      --primary: #e65c84;
      --primary-hover: #d1466f;
      --text-main: #4a4a4a;
      --text-muted: #888888;
      --border-radius: 20px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      color: var(--text-main);
      padding: 20px;
    }

    .card {
      background: var(--card-bg);
      padding: 30px;
      border-radius: var(--border-radius);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
      width: 100%;
      max-width: 500px;
      text-align: center;
      position: relative;
    }

    .progress-bar {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-bottom: 20px;
    }

    .dot {
      width: 16px;
      height: 6px;
      background-color: #f0d0d8;
      border-radius: 10px;
      transition: background-color 0.3s;
    }

    .dot.active {
      background-color: var(--primary);
    }

    .step-header {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    h2 {
      font-size: 1.6rem;
      margin-bottom: 8px;
      color: #2b2b2b;
    }

    p.subtitle {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 25px;
    }

    .step-content {
      display: none;
    }

    .step-content.active {
      display: block;
    }

    /* Step 1: Decision */
    .btn-container {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 15px;
      min-height: 120px;
      position: relative;
    }

    .btn {
      padding: 10px 24px;
      border-radius: 25px;
      border: none;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background-color: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
    }

    .btn-secondary {
      background-color: #f0f0f0;
      color: #666;
      position: absolute;
    }

    /* Step 2: Date Pick */
    input[type="date"] {
      width: 100%;
      padding: 12px;
      border: 1px solid #eee;
      border-radius: 10px;
      margin-bottom: 20px;
      outline: none;
      text-align: center;
      font-size: 1rem;
    }

    /* Step 3: Food Grid */
    .food-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }

    .food-item {
      border: 2px solid #f5f5f5;
      border-radius: 15px;
      padding: 10px;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    .food-item.selected {
      border-color: var(--primary);
      background-color: #fff9fa;
    }

    .food-item img {
      width: 100%;
      height: 90px;
      object-fit: cover;
      border-radius: 10px;
      margin-bottom: 6px;
    }

    .food-item h4 {
      font-size: 0.85rem;
    }

    /* Step 4: Letter */
    .letter-card {
      background: #fafafa;
      padding: 20px;
      border-radius: 15px;
      border: 1px dashed #ffd4e0;
      text-align: right;
      line-height: 1.6;
      font-size: 0.9rem;
      margin-bottom: 20px;
    }

    .summary-box {
      margin-top: 15px;
      padding-top: 10px;
      border-top: 1px solid #eee;
      color: var(--primary);
      font-weight: bold;
    }

    .back-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <div class="card">
    <button class="back-btn" id="backBtn" onclick="prevStep()" style="display: none;">← رجوع</button>
    
    <div class="progress-bar">
      <div class="dot active"></div>
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>

    <!-- Step 1 -->
    <div class="step-content active" id="step1">
      <div class="step-header">الخطوة 1 من 4</div>
      <h2>هل تريد الخروج معي في موعد؟ 🌸</h2>
      <p class="subtitle">سؤال واحد فقط.. وبقية الأمر أسهل مما تتوقع</p>
      
      <div class="btn-container" id="btnContainer">
        <button class="btn btn-primary" onclick="nextStep()">حسناً 💖</button>
        <button class="btn btn-secondary" id="noBtn">لا 🙈</button>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="step-content" id="step2">
      <div class="step-header">الخطوة 2 من 4</div>
      <h2>متى نلتقي؟ 📅</h2>
      <p class="subtitle">اختر اليوم الذي يناسبك، وسأجعل بقية الأسبوع ينتظر</p>
      
      <input type="date" id="datePicker">
      <button class="btn btn-primary" style="width: 100%;" onclick="confirmDate()">فقط هذا اليوم! ✨</button>
    </div>

    <!-- Step 3 -->
    <div class="step-content" id="step3">
      <div class="step-header">الخطوة 3 من 4</div>
      <h2>ماذا نأكل؟ 🍽️</h2>
      <p class="subtitle">اختر كل ما تشتهيه - يمكنك اختيار أكثر من طبق</p>
      
      <div class="food-grid">
        <div class="food-item" onclick="toggleFood(this, 'نودلز اللحم')">
          <img src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=300" alt="نودلز">
          <h4>نودلز اللحم</h4>
        </div>
        <div class="food-item" onclick="toggleFood(this, 'شواء')">
          <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=300" alt="شواء">
          <h4>شواء</h4>
        </div>
        <div class="food-item" onclick="toggleFood(this, 'رامن')">
          <img src="https://images.unsplash.com/photo-1591814468924-caf88d1232e1?w=300" alt="رامن">
          <h4>رامن</h4>
        </div>
        <div class="food-item" onclick="toggleFood(this, 'وجبات خفيفة')">
          <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=300" alt="وجبات خفيفة">
          <h4>وجبات خفيفة</h4>
        </div>
      </div>
      <button class="btn btn-primary" style="width: 100%;" onclick="nextStep()">التالي ❤️</button>
    </div>

    <!-- Step 4 -->
    <div class="step-content" id="step4">
      <div class="step-header">الخطوة 4 من 4</div>
      <h2>رسالة صغيرة لك 💌</h2>
      
      <div class="letter-card">
        من بين كل الأيام، اخترت هذا اليوم لنكون فيه معاً.. ومن بين كل الأطباق، اخترت ما يجعل قلبك يبتسم. ✨
        <br><br>
        سأحفظ التاريخ، وسأصل مبكراً، وسأبتسم أكثر مما ينبغي!
        <div class="summary-box" id="summaryText"></div>
      </div>

      <button class="btn btn-primary" style="width: 100%;" onclick="resetForm()">اقرأ مرة أخرى 🔄</button>
    </div>
  </div>

  <script>
    let currentStep = 1;
    let selectedDate = '';
    let selectedFoods = [];

    // زر "لا" الذي يهرب عند الاقتراب منه
    const noBtn = document.getElementById('noBtn');
    const container = document.getElementById('btnContainer');

    noBtn.addEventListener('mouseover', () => {
      const containerRect = container.getBoundingClientRect();
      const btnRect = noBtn.getBoundingClientRect();

      const maxX = containerRect.width - btnRect.width;
      const maxY = containerRect.height - btnRect.height;

      const randomX = Math.floor(Math.random() * maxX) - (maxX / 2);
      const randomY = Math.floor(Math.random() * maxY) - (maxY / 2);

      noBtn.style.transform = `translate(${randomX}px, ${randomY}px)`;
    });

    function updateStep() {
      document.querySelectorAll('.step-content').forEach(step => step.classList.remove('active'));
      document.getElementById(`step${currentStep}`).classList.add('active');

      document.querySelectorAll('.dot').forEach((dot, index) => {
        if (index < currentStep) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      document.getElementById('backBtn').style.display = currentStep > 1 && currentStep < 4 ? 'block' : 'none';
    }

    function nextStep() {
      if (currentStep < 4) {
        currentStep++;
        updateStep();
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        currentStep--;
        updateStep();
      }
    }

    function confirmDate() {
      const dateVal = document.getElementById('datePicker').value;
      if (!dateVal) {
        alert('يرجى تحديد التاريخ أولاً 📅');
        return;
      }
      selectedDate = dateVal;
      nextStep();
    }

    function toggleFood(element, foodName) {
      element.classList.toggle('selected');
      if (selectedFoods.includes(foodName)) {
        selectedFoods = selectedFoods.filter(item => item !== foodName);
      } else {
        selectedFoods.push(foodName);
      }
    }

    function renderSummary() {
      const summaryBox = document.getElementById('summaryText');
      const foodsText = selectedFoods.length > 0 ? selectedFoods.join('، ') : 'لم يتم اختيار وجبة محدده';
      summaryBox.innerHTML = `📅 الموعد: ${selectedDate}<br>🍲 الوجبة المختارة: ${foodsText}`;
    }

    const originalNextStep = nextStep;
    nextStep = function() {
      if (currentStep === 3) {
        renderSummary();
      }
      originalNextStep();
    }

    function resetForm() {
      currentStep = 1;
      selectedFoods = [];
      document.querySelectorAll('.food-item').forEach(e => e.classList.remove('selected'));
      document.getElementById('datePicker').value = '';
      noBtn.style.transform = 'translate(0,0)';
      updateStep();
    }
  </script>
</body>
</html>
